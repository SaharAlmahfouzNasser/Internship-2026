# Qwen / DashScope OpenAI-compatible API
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
# Optional if using ChatOpenAI fallback instead of langchain-deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: use same Qwen model as evaluator; or set another OpenAI-compatible model
EVALUATOR_PROVIDER=qwen
EVALUATOR_MODEL=qwen-plus
